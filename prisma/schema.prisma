generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  uuid   String  @id @default(uuid())
  name   String
  email  String  @unique
  password String
  grills Grill[]
}

enum Meat {
  FRANGO
  SUINA
  BOVINA
  LINGUICA
}

enum Sides {
  PAO_DE_ALHO
  VINAGRETE
  QUEIJO_QUALHO
  FAROFA
}

enum Vegetables {
  PIMENTOES
  BATATA
  MILHO
  ABOBINHA
}

enum Drinks {
  CERVEJA
  REFRIGERANTE
  AGUA
  SUCO
  ENERGETICO
}

enum Extras {
  CARVAO
  GELO
}

model Climate {
  uuid            String  @id @default(uuid())
  climate         String
  temperature     Int
  weatherForecast String
  grills          Grill[]
}

model Grill {
  uuid        String  @id @default(uuid())
  name        String
  date        DateTime
  duration    Float
  adult       Int
  kids        Int
  isVegan     Boolean
  userUuid    String
  climateUuid String
  user        User    @relation(fields: [userUuid], references: [uuid])
  climate     Climate @relation(fields: [climateUuid], references: [uuid])
  items       Item[]
}

model Item {
  uuid      String      @id @default(uuid())
  meat      Meat?
  side      Sides?
  vegetable Vegetables?
  drink     Drinks?
  extra     Extras?
  quantity  Float?
  weight    String?
  grillUuid String
  grill     Grill       @relation(fields: [grillUuid], references: [uuid])
}