generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  uuid     String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  grills   Grill[]
}

enum Meat {
  FRANGO
  SUINA
  BOVINA
  LINGUICA
}

enum Sides {
  PAO_DE_ALHO
  VINAGRETE
  QUEIJO_COALHO
  FAROFA
}

enum Vegetables {
  PIMENTOES
  BATATA
  MILHO
  ABOBRINHA
}

enum Drinks {
  CERVEJA
  REFRIGERANTE
  AGUA
  SUCO
  ENERGETICO
}

enum Extras {
  CARVAO
  GELO
  SAL_GROSSO
}

model Grill {
  uuid        String       @id @default(uuid())
  name        String
  date        DateTime
  time        String
  adults      Int
  kids        Int
  isVegan     Boolean
  city        String
  userUuid    String
  user        User         @relation(fields: [userUuid], references: [uuid])
  items       Item[]
  comprovante Comprovante?
}

model Climate {
  uuid        String       @id @default(uuid())
  climate     String
  temperature Int
  city        String
  comprovante Comprovante?
}

model Comprovante {
  uuid        String   @id @default(uuid())
  grillUuid   String   @unique
  climateUuid String   @unique
  grill       Grill    @relation(fields: [grillUuid], references: [uuid], onDelete: Cascade)
  climate     Climate  @relation(fields: [climateUuid], references: [uuid])
  createdAt   DateTime @default(now())
}

model Item {
  uuid      String      @id @default(uuid())
  meat      Meat?
  side      Sides?
  vegetable Vegetables?
  drink     Drinks?
  extra     Extras?
  quantity  Float?
  weight    Float?
  grillUuid String
  grill     Grill       @relation(fields: [grillUuid], references: [uuid], onDelete: Cascade)
}